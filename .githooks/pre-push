#!/usr/bin/env python3
"""
.githooks/pre-push
Runs automatically before every `git push`. Deliverability hygiene:
  1. Postmark hard bounces -> suppression_list.csv   (fast API poll)
  2. Mailtrap bounces (legacy)                        (fast API poll)
  3. apply_suppression: de-dupe final + rebuild contacts_live
Never blocks the push.

The heavy Proton DSN inbox scan is NOT run here (it reads full mailboxes and is
slow) -- run it on demand / after a campaign:
    python scripts/sync_proton_bounces.py
Enable this hook with: git config core.hooksPath .githooks
"""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent.parent))

for mod in ("sync_postmark_bounces", "sync_mailtrap_bounces"):
    try:
        m = __import__(f"scripts.{mod}", fromlist=["run"])
        m.run(silent=False)
    except Exception as e:
        print(f"[pre-push] {mod} skipped: {e}", file=sys.stderr)

try:
    from scripts.apply_suppression import main as _apply
    _apply()
except Exception as e:
    print(f"[pre-push] apply_suppression skipped: {e}", file=sys.stderr)

sys.exit(0)  # never block the push
